{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": "src",
    "paths": {
      // "@src/config/*": ["config/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/components/Slider"],
  "exclude": ["node_modules"]
}
